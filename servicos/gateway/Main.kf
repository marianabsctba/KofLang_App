// Gateway: porta de entrada da suíte Be Safe. Serve o frontend e repassa
// cada chamada /api para o microsserviço responsável.
import kof.http

String urlServico(String variavel, String padrao) {
    var valor = config.env(variavel)
    if (valor != null) {
        return valor
    }
    return padrao
}

String phishing() = urlServico("PHISHING_URL", "http://localhost:8081")
String senhas() = urlServico("SENHAS_URL", "http://localhost:8082")

String indisponivel() = "{\"erro\": \"serviço indisponível, tente novamente\"}"

// O cliente http devolve só o corpo; erro de validação do serviço chega
// como {"erro": ...} e é repassado como 400.
String repassarPost(String url, String corpo) {
    try {
        var resposta = http.post(url, corpo)
        if (resposta.startsWith("{\"erro\"")) {
            return status(400, resposta)
        }
        return resposta
    } catch (Exception e) {
        return status(502, indisponivel())
    }
}

String repassarGet(String url) {
    try {
        return http.get(url)
    } catch (Exception e) {
        return status(502, indisponivel())
    }
}

// Só repassa o tamanho se for numérico, para nada além de dígitos
// chegar na URL do serviço interno.
String parametroTamanho(String? tamanho) {
    if (tamanho == null) {
        return ""
    }
    if (tamanho.length == 0 || tamanho.length > 3) {
        return ""
    }
    for (var i = 0; i < tamanho.length; i++) {
        var c = tamanho.charAt(i) as Int
        if (c < 48 || c > 57) {
            return ""
        }
    }
    return "?tamanho=" + tamanho
}

main() {
    http.timeout(10000)
    var app = web.app()
    app.health("/saude")

    app.post("/api/phishing") {
        return repassarPost(phishing() + "/analisar", body())
    }

    app.post("/api/senhas/avaliar") {
        return repassarPost(senhas() + "/avaliar", body())
    }

    app.get("/api/senhas/gerar") {
        return repassarGet(senhas() + "/gerar" + parametroTamanho(query("tamanho")))
    }

    var frontend = config.env("FRONTEND_DIR")
    if (frontend != null) {
        app.serveDir("/", frontend)
    }

    app.listen(porta(8080))
}

Int porta(Int padrao) {
    var valor = config.env("PORTA")
    if (valor != null) {
        return Integer.parseInt(valor)
    }
    return padrao
}
